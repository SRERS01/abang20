                        depth: depth + 1,
                        actionsHistory: [...actionsHistory, { selectorIndex: edge.index, edgeDescription: `${edge.tagName} -> "${edge.text}"` }]
                    });
                }
            }
        }

    } catch (err) {
        console.error(`[❌ Node Processing Error] Error parsing state machine parameters: ${err.message}`);
    } finally {
        await page.close();
    }
