async function runVisualReporter() {
    console.log(`[+] Launching Automated Scanner & Visual Reporting Engine...`);
    const browser = await puppeteer.launch({ headless: true });

    for (let targetField of FORM_FIELDS) {
        console.log(`\n[*] Auditing Input Layer: ${targetField.name}`);

        for (let payload of payloads) {
            const page = await browser.newPage();
            // Set viewport size explicitly to ensure screenshots capture a clean overview area
            await page.setViewport({ width: 1280, height: 800 });

            let lastServerResponseText = "";
            let screenshotCount = Date.now();

            // Monitor backend infrastructure traffic text logs
            page.on('response', async (response) => {
                try {
                    const contentType = response.headers()['content-type'] || '';
                    if (contentType.includes('json') || contentType.includes('text/html')) {
                        lastServerResponseText = await response.text();
                    }
                } catch (err) {}
            });

            // Dialog context listener to catch and document the alert block
            page.on('dialog', async dialog => {
                if (dialog.type() === 'alert') {
                    console.log(`[🚨 ALERT TRIGGERED] Successful injection on: ${targetField.name}`);
                    await dialog.dismiss();
                    
                    // Create a descriptive file name for the screenshot asset
                    const screenshotPath = `screenshot_${targetField.name.replace(/\s+/g, '_')}_${screenshotCount}.png`;
                    
                    // Take the snapshot after the dialog box closes to document the DOM state changes visually
                    await page.screenshot({ path: screenshotPath, fullPage: true });
                    console.log(`[📸 SCREENSHOT SAVED] Visual proof logged out to: ${screenshotPath}`);

                    // Pass the verified screenshot reference path straight into the automated markdown compilation engine
                    generateH1ReportWithMedia(targetField.name, payload, page.url(), lastServerResponseText, screenshotPath);
                }
            });

            try {
                await page.goto(targetUrl, { waitUntil: 'networkidle2' });

                // Fill form input fields
                for (let currentField of FORM_FIELDS) {
                    await page.waitForSelector(currentField.selector, { timeout: 4000 });
                    await page.click(currentField.selector);

                    await page.keyboard.down('Control');
                    await page.keyboard.press('A');
                    await page.keyboard.up('Control');
                    await page.keyboard.press('Backspace');

                    if (currentField.name === targetField.name) {
                        await page.type(currentField.selector, payload);
                    } else {
                        await page.type(currentField.selector, currentField.safeValue);
                    }
                }

                // Trigger submission processing
                await page.waitForSelector(SUBMIT_SELECTOR, { timeout: 4000 });
                await Promise.all([
                    page.click(SUBMIT_SELECTOR),
                    page.waitForNavigation({ waitUntil: 'networkidle2', timeout: 5000 }).catch(() => {})
                ]);

                // Give the browser client layout scripts time to execute sinks visually
                await new Promise(resolve => setTimeout(resolve, 1500));

            } catch (error) {
                // Ignore general runtime request drops or page element navigation drops
            } finally {
                await page.close();
            }
        }
    }

    console.log(`\n[+] Scan Pipeline and Media Capture Sequence Complete.`);
    await browser.close();
}

runVisualReporter();

