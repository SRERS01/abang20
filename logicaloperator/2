### PART 9. Build a Boolean law verifier in Python

This exercise automatically checks whether the principal Boolean laws hold for every possible input.

```python

from itertools import product

def verify(name, left, right):
    for values in product([False, True], repeat=3):
        A, B, C = values

        if left(A, B, C) != right(A, B, C):
            print(f"FAILED: {name}", values)
            return

    print(f"PASSED: {name}")

laws = [
    (
        "AND identity",
        lambda A, B, C: A and True,
        lambda A, B, C: A
    ),
    (
        "OR identity",
        lambda A, B, C: A or False,
        lambda A, B, C: A
    ),
    (
        "De Morgan AND",
        lambda A, B, C: not (A and B),
        lambda A, B, C: (not A) or (not B)
    ),
    (
        "De Morgan OR",
        lambda A, B, C: not (A or B),
        lambda A, B, C: (not A) and (not B)
    ),
    (
        "Distributive AND",
        lambda A, B, C: A and (B or C),
        lambda A, B, C: (A and B) or (A and C)
    ),
    (
        "Absorption",
        lambda A, B, C: A or (A and B),
        lambda A, B, C: A
    ),
]

for name, left, right in laws:
    verify(name, left, right)
```

This is a small form of exhaustive Boolean verification.

