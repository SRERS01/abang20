  cat << 'EOF' > main.tf.mock
  resource "aws_security_group_rule" "rdp_open" {
    type        = "ingress"
    from_port   = 3389
    to_port     = 3389
    cidr_blocks = ["0.0.0.0/0"]
  }
  EOF

  grep -E "3389|22" main.tf.mock && grep "0.0.0.0/0" main.tf.mock && echo "[IaC BLOCKED] Admin port exposed globally!"
  ```

